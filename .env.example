# Canonical public origin used by metadata, sitemap, and robots generation.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudflare R2 Storage (Optional in local development - falls back to public/ directory)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Database (Default: local SQLite database "file:local.db", or Turso/D1 remote connection)
DATABASE_URL=file:local.db
DATABASE_AUTH_TOKEN=

# Admin Dashboard Password (used for /admin/files and file management API)
ADMIN_PASSWORD=adi-admin-2026

# Secret key for IP hashing & cryptographic token signing
FILE_SIGNING_SECRET=adi-haditya-secret-file-signing-key-2026
